# Environnement Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
dist/
build/
*.egg-info/

# Données et secrets de l'utilisateur : JAMAIS dans le dépôt
config.toml
config.*.toml
!config.example.toml
*.fit
*.FIT
*.tcx
*.gpx
# Les cartes de `ourouler sortie` portent la géométrie complète de la boucle,
# donc le point de départ du mainteneur. Elles sont écrites dans le dossier
# courant, y compris quand on lance la commande à la racine du dépôt.
*.html
# ...sauf les maquettes du cycle UX, qui sont du travail de conception et
# non une sortie de `ourouler sortie` (la raison de la règle ci-dessus).
!docs/ux/*.html
# ... ni la page d'entrée du front, qui est du code source (lot F2).
!front/index.html
!tests/fixtures/**
# ... mais pas le bytecode que pytest y laisse en chargeant le generateur.
tests/fixtures/**/__pycache__/
cache/
data/
.env
.env.*
!.env.example
!deploiement/.env.example

# Front (lot F2) : les dépendances s'installent, elles ne se commitent pas.
front/node_modules/
front/dist/

# Outillage local
.claude/worktrees/
.DS_Store
