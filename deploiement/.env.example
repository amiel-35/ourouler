# Copier en `deploiement/.env` et renseigner (fichier ignoré par git,
# `.gitignore` couvre déjà `.env` et `.env.*`). Aucune valeur ici : c'est un
# gabarit, exactement comme config.example.toml pour le fichier TOML.

# Secrets et données personnelles (règle absolue 1 de CLAUDE.md : jamais
# commités, ni ici ni dans une image) — voir docs/journal/sprints/heberge_minimal_contrat.md.
OUROULER_INTERVALS_API_KEY=
OUROULER_INTERVALS_ATHLETE_ID=
OUROULER_DEPART_NOM=
OUROULER_DEPART_LATITUDE=
OUROULER_DEPART_LONGITUDE=
OUROULER_BROUTER_URL=
OUROULER_BROUTER_UTILISATEUR=
OUROULER_BROUTER_MOT_DE_PASSE=

# Authentification basique du serveur statique.
OUROULER_WWW_UTILISATEUR=
OUROULER_WWW_MOT_DE_PASSE=

# Chemin, sur la machine hôte, du fichier TOML non-secrets (cycliste, vélos,
# météo, séance, tenue...) — PAS le config.toml habituel : celui-là porte le
# départ et la clé Intervals, qui doivent ici rester hors de tout fichier.
# Voir deploiement/README.md pour le préparer.
OUROULER_CONFIG_HOTE=

# Optionnels (défauts raisonnables dans docker-compose.yml).
OUROULER_HEURE_GENERATION=06:00
OUROULER_PORT_HOTE=8080
