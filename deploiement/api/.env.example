# Copier en `deploiement/api/.env` et renseigner (fichier ignoré par git,
# `.gitignore` couvre déjà `.env` et `.env.*`). Aucune valeur ici : c'est un
# gabarit, exactement comme config.example.toml pour le fichier TOML.

# **Quel produit ce service sert** (api/session.py) : `personnel` (un seul
# cycliste — l'usage prévu ici, sur le Coolify du mainteneur) ou `heberge`
# (plusieurs cyclistes, aucune méthode de connexion branchée : toute route de
# données répond 401). Absente, la valeur est `heberge` — refuser est le seul
# défaut sûr pour un service exposé (lot L7.A). **Poser explicitement,**
# jamais compter sur un défaut qu'on n'a pas vérifié.
OUROULER_MODE=personnel

# Secrets et données personnelles (règle absolue 1 de CLAUDE.md : jamais
# commités, ni ici ni dans une image).
OUROULER_INTERVALS_API_KEY=
OUROULER_INTERVALS_ATHLETE_ID=
OUROULER_DEPART_NOM=
OUROULER_DEPART_LATITUDE=
OUROULER_DEPART_LONGITUDE=
OUROULER_BROUTER_URL=
OUROULER_BROUTER_UTILISATEUR=
OUROULER_BROUTER_MOT_DE_PASSE=

# Chemin, sur la machine hôte, du fichier TOML non-secrets (cycliste, vélos,
# météo, séance, tenue...) — PAS le config.toml habituel : celui-là porte le
# départ et la clé Intervals, qui doivent ici rester hors de tout fichier.
# Voir deploiement/api/config.example.toml et deploiement/api/README.md.
OUROULER_CONFIG_HOTE=

# Optionnel (défaut raisonnable dans docker-compose.yml).
OUROULER_PORT_HOTE=8000
